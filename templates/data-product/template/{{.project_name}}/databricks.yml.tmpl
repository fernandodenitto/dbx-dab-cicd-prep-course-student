# {{.project_name}} — generated from the Lakeshore data-product template.
bundle:
  name: {{.project_name}}
  databricks_cli_version: ">= 1.19.0"

include:
  - resources/*.yml

variables:
  catalog:
    description: The environment's catalog
  run_as_sp:
    description: Service principal that runs production jobs
    default: ""
  tags:
    type: complex
    default:
      project: {{.project_name}}
      owner: {{.owner_team}}

permissions:
  - group_name: users
    level: CAN_VIEW
  - group_name: admins
    level: CAN_MANAGE

presets:
  tags:
    environment: ${bundle.target}
    git_commit: ${bundle.git.commit}

targets:
  dev:
    mode: development
    default: true
    permissions:
      - user_name: ${workspace.current_user.userName}
        level: CAN_MANAGE
    variables:
      catalog: lakeshore_dev

  staging:
    mode: production
    workspace:
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/${bundle.target}
    presets:
      trigger_pause_status: PAUSED
    run_as:
      service_principal_name: ${var.run_as_sp}
    permissions:
      - service_principal_name: ${var.run_as_sp}
        level: CAN_MANAGE
    variables:
      catalog: lakeshore_staging
      run_as_sp:
        lookup:
          service_principal: sp-lakeshore-staging

  prod:
    mode: production
    workspace:
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/${bundle.target}
    run_as:
      service_principal_name: ${var.run_as_sp}
    permissions:
      - service_principal_name: ${var.run_as_sp}
        level: CAN_MANAGE
    variables:
      catalog: lakeshore_prod
      run_as_sp:
        lookup:
          service_principal: sp-lakeshore-prod
